# Node 22+. Keep this file's values as examples; real secrets belong in .env.
HOST=127.0.0.1
PORT=3000
SITE_URL=http://localhost:3000
# Keep false for review; enable only after deploying on the real CSL domain.
SEARCH_INDEXING=false
# Absolute private directory, OUTSIDE public_html and the repository in production.
DATA_DIR=./var
# Enable only behind a trusted loopback reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Email notifications: Mailtrap API is the preferred route.
MAIL_PROVIDER=mailtrap
MAILTRAP_API_TOKEN=
# Optional local MTA fallback: set MAIL_PROVIDER=sendmail explicitly.
SENDMAIL_PATH=
ENQUIRY_EMAIL=
# Comma-separated staff recipients above; copy address below.
ENQUIRY_CC=amit@axon.com.sg
MAIL_FROM_NAME=Custom Sports and Leisure Manufacturing Corp
MAIL_REPLY_TO=amit@axon.com.sg
MAIL_FROM=amit@axon.com.sg
# Optional AI. Leave BOTH blank for guided answers, with no API calls.
OPENAI_API_KEY=
OPENAI_MODEL=

# Set only after the dedicated staff chat has working HTTPS and login.
# Redirects /nexus and disables the old shared-code preview API when configured.
NEXUS_CHAT_URL=
# Staff preview access: run node scripts/set-nexus-password.mjs. Never commit a password/hash.
NEXUS_PASSWORD_HASH=
NEXUS_MODEL=
# Phase 2 placeholders only. No live Trello/email retrieval endpoints are enabled.
TRELLO_API_KEY=
TRELLO_API_TOKEN=
TRELLO_BOARD_ID=
TRELLO_API_SECRET=
# Mike, the public CSL AI Assistant. Choose groq or openai; keys stay server-only.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PUBLIC_CONTACT_EMAIL=
CUSTOMER_REPLY_TO=
CUSTOMER_ACK_CC=
